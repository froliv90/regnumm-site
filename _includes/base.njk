<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ seoTitulo or titulo }}</title>
  <meta name="description" content="{{ seoDescricao or descricao }}" />
  <link rel="canonical" href="{{ site.url }}{{ canonical or page.url }}" />

  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:url" content="{{ site.url }}{{ canonical or page.url }}" />
  <meta property="og:title" content="{{ ogTitulo or seoTitulo or titulo }}" />
  <meta property="og:description" content="{{ ogDescricao or seoDescricao or descricao }}" />
  <meta property="og:image" content="{{ site.url }}{{ ogImage or site.ogImage }}" />
  <meta property="og:locale" content="{{ site.locale }}" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ ogTitulo or seoTitulo or titulo }}" />
  <meta name="twitter:description" content="{{ ogDescricao or seoDescricao or descricao }}" />
  {% if naoIndexar %}<meta name="robots" content="noindex, follow" />{% endif %}

  <link rel="icon" type="image/svg+xml" href="/assets/icones/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/icones/favicon-32.png" />
  <link rel="apple-touch-icon" href="/assets/icones/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#FFFFFF" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700;9..40,800&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/assets/css/site.css" />
  <script>document.documentElement.classList.add('js')</script>
  {% if feedRss %}<link rel="alternate" type="application/atom+xml" title="{{ site.nome }}" href="{{ site.url }}/blog/feed.xml" />{% endif %}

  {% if redirecionarAncoras %}
  <!-- As âncoras antigas viraram URLs próprias. O fragmento (#processo) nunca
       chega ao servidor, então este redirecionamento só pode ser feito aqui,
       no cliente, e precisa rodar antes da primeira pintura. -->
  <script>
    (function () {
      var mapa = {
        '#problema': '/diagnostico/',
        '#mapa': '/diagnostico/',
        '#diagnostico': '/diagnostico/',
        '#processo': '/processo/',
        '#sobre': '/sobre/',
        '#privacidade': '/privacidade/',
        '#termos': '/termos/'
      };
      var destino = mapa[window.location.hash];
      if (destino) window.location.replace(destino);
    })();
  </script>
  {% endif %}

  {% if schema %}<script type="application/ld+json">{{ schema | safe }}</script>{% endif %}

  <!-- ANALYTICS — a chave do projeto fica em _data/site.json -->
  {% raw %}<script>
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog && window.posthog.__loaded)||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
  </script>{% endraw %}
  <script>
    posthog.init('{{ site.posthogToken }}', { api_host: '{{ site.posthogHost }}', defaults: '2026-01-30' })
  </script>
</head>
<body>

  <nav id="nav">
    <a href="/" class="nav-logo">R<span>e</span>gnumm</a>

    <ul class="nav-links" id="nav-links">
      {%- for item in nav.principal %}
      <li><a href="{{ item.href }}"{% if item.href == page.url %} aria-current="page"{% endif %}>{{ item.texto }}</a></li>
      {%- endfor %}
      {#- No painel do celular o CTA entra como último item da lista. -#}
      <li class="nav-links-cta"><a href="{{ site.linkTeste }}">{{ nav.cta.texto }}</a></li>
    </ul>
    {#- A ação do cabeçalho, em todas as páginas, é o Mapa Financeiro. A conversa
        com o fundador ficou no botão flutuante, no canto inferior direito. -#}
    <a href="{{ site.linkTeste }}" class="nav-cta"
       onclick="if(window.posthog)posthog.capture('teste_cta_click',{location:'header'})">{{ nav.cta.texto }}</a>

    {#- Abaixo de 960px o menu horizontal não cabe. Sem este botão o site fica
        sem navegação nenhuma no celular, que é o que acontecia até aqui. -#}
    <button type="button" class="nav-toggle" id="nav-toggle"
            aria-controls="nav-links" aria-expanded="false" aria-label="Abrir o menu">
      <span></span><span></span><span></span>
    </button>
  </nav>

  {{ content | safe }}

  <footer>
    <a href="/" class="f-logo">R<span>e</span>gnumm</a>
    <p class="f-copy">© 2026 {{ site.nome }} &nbsp;·&nbsp; {{ site.autor }} &nbsp;·&nbsp; CNPJ {{ site.cnpj }} &nbsp;·&nbsp; <a href="/privacidade/">Privacidade</a> &nbsp;·&nbsp; <a href="/termos/">Termos</a></p>
    <ul class="f-links">
      {%- for item in nav.rodape %}
      <li><a href="{{ item.href }}">{{ item.texto }}</a></li>
      {%- endfor %}
      <li><a href="{{ site.whatsapp }}" target="_blank" rel="noopener" onclick="if(window.posthog)posthog.capture('lead_whatsapp_direto',{location:'footer'})">WhatsApp</a></li>
      {%- if site.email %}
      <li><a href="mailto:{{ site.email }}">E-mail</a></li>
      {%- endif %}
    </ul>
  </footer>

  {#- WhatsApp com o fundador, fixo no canto inferior direito de todas as
      páginas. Some quando o menu do celular está aberto. -#}
  <a href="{{ ofertas.duvida.whatsappTexto | whatsapp(site.numeroWhatsapp) }}"
     target="_blank" rel="noopener" class="whats-flutuante"
     aria-label="Falar no WhatsApp com o fundador" title="Falar no WhatsApp com o fundador"
     onclick="if(window.posthog)posthog.capture('lead_whatsapp_direto',{location:'flutuante'})">
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3.6 20.4l1.3-4A8.4 8.4 0 1 1 8 19.3z"/>
      <path d="M9.3 8.7c.2-.5.6-.7 1-.7h.3c.2 0 .4.1.5.4l.6 1.4c.1.2 0 .5-.1.7l-.5.6a6.5 6.5 0 0 0 2.8 2.8l.6-.5c.2-.2.5-.2.7-.1l1.4.6c.3.1.4.3.4.5v.3c0 .4-.2.8-.7 1-.8.4-1.7.4-2.6 0a9.2 9.2 0 0 1-4.4-4.4c-.4-.9-.4-1.8 0-2.6z"/>
    </svg>
  </a>

  <script src="/assets/js/site.js"></script>
</body>
</html>
