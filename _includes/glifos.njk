{#- Glifos geométricos dos quatro perfis e da esteira.

    SVG inline com currentColor: a cor vem da classe .warm ou .cool do
    contêiner, nunca do próprio desenho. São decorativos (aria-hidden): o texto
    ao lado já carrega o sentido.

    Um lugar só para os sete desenhos. Os três da esteira aparecem em dois
    arquivos (processo.njk e jornada.njk), e desenho colado em dois lugares
    diverge na primeira correção.

    Uso: {% from "glifos.njk" import glifo %} e depois {{ glifo("mapa") }} -#}

{%- macro glifo(nome) -%}
{%- if nome == "visionario" -%}
<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
  <circle cx="100" cy="100" r="48" stroke-width="2.4" stroke-dasharray="195 8"/>
  <circle cx="100" cy="52" r="7" fill="currentColor" stroke="none"/>
</svg>
{%- elif nome == "executor" -%}
<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
  <line x1="95" y1="90" x2="75" y2="90" stroke-width="2" opacity=".3"/>
  <line x1="95" y1="100" x2="65" y2="100" stroke-width="2" opacity=".45"/>
  <line x1="95" y1="110" x2="75" y2="110" stroke-width="2" opacity=".3"/>
  <path d="M158,100 L100,72 L118,100 L100,128 Z" fill="currentColor" stroke="none"/>
</svg>
{%- elif nome == "guardiao" -%}
<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <polygon points="58,58 142,58 142,142 58,142" stroke-width="3"/>
  <g opacity=".6" stroke-width="1.8">
    <line x1="100" y1="58" x2="100" y2="72"/>
    <line x1="142" y1="100" x2="128" y2="100"/>
    <line x1="100" y1="142" x2="100" y2="128"/>
    <line x1="58" y1="100" x2="72" y2="100"/>
  </g>
  <circle cx="100" cy="100" r="8" fill="currentColor" stroke="none"/>
</svg>
{%- elif nome == "estrategista" -%}
<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <polygon points="100,42 150,71 150,129 100,158 50,129 50,71" stroke-width="2.4" stroke-dasharray="20 6"/>
  <g opacity=".45" stroke-width="1.4" stroke-dasharray="3 4">
    <line x1="100" y1="100" x2="70" y2="55"/>
    <line x1="100" y1="100" x2="115" y2="48"/>
    <line x1="100" y1="100" x2="145" y2="65"/>
    <line x1="100" y1="100" x2="150" y2="110"/>
  </g>
  <circle cx="100" cy="100" r="6" fill="currentColor" stroke="none"/>
</svg>
{%- elif nome == "mapa" -%}
<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
  <line x1="70" y1="20" x2="70" y2="190" stroke-width="1" opacity=".28"/>
  <line x1="130" y1="20" x2="130" y2="190" stroke-width="1" opacity=".28"/>
  <line x1="15" y1="70" x2="185" y2="70" stroke-width="1" opacity=".28"/>
  <line x1="15" y1="130" x2="185" y2="130" stroke-width="1" opacity=".28"/>
  <path d="M20,108 C50,93 80,118 110,98 C140,83 160,103 185,93" stroke-width="1.8" opacity=".45"/>
  <circle cx="100" cy="150" r="14" stroke-width="1.4" opacity=".55"/>
  <circle cx="100" cy="150" r="7" fill="currentColor" stroke="none"/>
</svg>
{%- elif nome == "bussola" -%}
<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true">
  <circle cx="100" cy="150" r="22" stroke-width="1.4" opacity=".5"/>
  <g opacity=".5" stroke-width="1.4">
    <line x1="122" y1="150" x2="128" y2="150"/>
    <line x1="115.5" y1="134.5" x2="120" y2="129"/>
    <line x1="100" y1="128" x2="100" y2="122"/>
    <line x1="84.5" y1="134.5" x2="80" y2="129"/>
    <line x1="78" y1="150" x2="72" y2="150"/>
    <line x1="84.5" y1="165.5" x2="80" y2="171"/>
    <line x1="100" y1="172" x2="100" y2="178"/>
    <line x1="115.5" y1="165.5" x2="120" y2="171"/>
  </g>
  <circle cx="100" cy="150" r="7" fill="currentColor" stroke="none"/>
  <line x1="100" y1="150" x2="100" y2="55" stroke-width="2.4" opacity=".9"/>
  <path d="M100,45 L106,58 L94,58 Z" fill="currentColor" stroke="none"/>
</svg>
{%- elif nome == "arquitetura" -%}
<svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <circle cx="100" cy="150" r="7" fill="currentColor" stroke="none"/>
  <polygon points="64,140 136,140 136,118 64,118" stroke-width="2"/>
  <polygon points="76,118 124,118 124,88 76,88" stroke-width="2"/>
  <polygon points="88,88 112,88 112,62 88,62" stroke-width="2"/>
  <circle cx="100" cy="50" r="7" stroke-width="1.8" opacity=".7"/>
  <path d="M100,57 C93,62 85,60 82,64" opacity=".6" stroke-width="1.6"/>
</svg>
{%- endif -%}
{%- endmacro %}
