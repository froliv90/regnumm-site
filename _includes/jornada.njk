{#- Faixa da jornada. Cada etapa leva à página que a explica; "Governa o
    reino" leva ao agendamento do Mapa Financeiro, que é a porta de entrada. -#}
{% from "glifos.njk" import glifo %}
<div class="story {{ 'story-borda' if bordaTopo }}">
  <a href="/diagnostico/" class="story-item" onclick="if(window.posthog)posthog.capture('jornada_click',{etapa:'mapa',origem:'{{ jornadaOrigem }}'})">
    <div class="drawer-glyph warm">{{ glifo("mapa") }}</div>
    <div class="story-verb">Descobre</div>
    <div class="story-label">Mapa Financeiro</div>
  </a>
  <div class="story-sep" aria-hidden="true">→</div>
  <a href="/processo/#bussola-financeira" class="story-item" onclick="if(window.posthog)posthog.capture('jornada_click',{etapa:'bussola',origem:'{{ jornadaOrigem }}'})">
    <div class="drawer-glyph warm">{{ glifo("bussola") }}</div>
    <div class="story-verb">Direciona</div>
    <div class="story-label">Bússola Financeira</div>
  </a>
  <div class="story-sep" aria-hidden="true">→</div>
  <a href="/processo/#arquitetura-financeira" class="story-item" onclick="if(window.posthog)posthog.capture('jornada_click',{etapa:'arquitetura',origem:'{{ jornadaOrigem }}'})">
    <div class="drawer-glyph warm">{{ glifo("arquitetura") }}</div>
    <div class="story-verb">Constrói</div>
    <div class="story-label">Arquitetura Financeira</div>
  </a>
  <div class="story-sep" aria-hidden="true">→</div>
  <a href="/#ofertas" class="story-item story-item-fim" onclick="if(window.posthog)posthog.capture('mapa_cta_click',{location:'jornada',origem:'{{ jornadaOrigem }}'})">
    <div class="drawer-glyph" aria-hidden="true"></div>
    <div class="story-verb">Conduz</div>
    <div class="story-label">As suas decisões</div>
  </a>
</div>
