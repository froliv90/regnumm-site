{#- Escada de produtos: os dois níveis pagos SEMPRE lado a lado.
    A especificação é explícita: não exibir em telas separadas sem a comparação
    direta entre os dois preços. É a comparação que faz a escada funcionar. -#}
<div class="ofertas">

  <div class="oferta r">
    <p class="oferta-nome">{{ ofertas.pdf.nome }}</p>
    <p class="oferta-preco"><span class="data-stat">{{ ofertas.pdf.valor | brl }}</span></p>
    <p class="oferta-entrega">{{ ofertas.pdf.entrega }}</p>
    <a href="{{ ofertas.pdf.whatsappTexto | whatsapp(site.numeroWhatsapp) }}"
       target="_blank" rel="noopener"
       class="oferta-btn"
       onclick="if(window.posthog)posthog.capture('oferta_click',{oferta:'pdf',origem:'{{ ofertaOrigem or page.fileSlug }}'})">
      {{ ofertas.pdf.cta }} — {{ ofertas.pdf.valor | brl }}
    </a>
    <a href="{{ ofertas.duvida.whatsappTexto | whatsapp(site.numeroWhatsapp) }}"
       target="_blank" rel="noopener" class="oferta-duvida">{{ ofertas.duvida.texto }}</a>
  </div>

  <div class="oferta oferta-destaque r d1">
    <p class="oferta-nome">{{ ofertas.sessao.nome }}</p>
    <p class="oferta-preco"><span class="data-stat">{{ ofertas.sessao.valor | brl }}</span></p>
    <p class="oferta-entrega">{{ ofertas.sessao.entrega }}</p>
{%- if ofertas.sessao.itens %}
    <ul class="oferta-itens">
      {%- for item in ofertas.sessao.itens %}
      <li>{{ item }}</li>
      {%- endfor %}
    </ul>
{%- endif %}
    <a href="{{ ofertas.sessao.whatsappTexto | whatsapp(site.numeroWhatsapp) }}"
       target="_blank" rel="noopener"
       class="oferta-btn oferta-btn-forte"
       onclick="if(window.posthog)posthog.capture('oferta_click',{oferta:'sessao',origem:'{{ ofertaOrigem or page.fileSlug }}'})">
      {{ ofertas.sessao.cta }} — {{ ofertas.sessao.valor | brl }}
    </a>
    <a href="{{ ofertas.duvida.whatsappTexto | whatsapp(site.numeroWhatsapp) }}"
       target="_blank" rel="noopener" class="oferta-duvida">{{ ofertas.duvida.texto }}</a>
  </div>

</div>
