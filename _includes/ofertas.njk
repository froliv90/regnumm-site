{#- Oferta paga do resultado completo. O PDF avulso foi descontinuado; resta a
    sessão com direcionamento. Hoje nenhum template inclui este arquivo. -#}
<div class="ofertas">

  <div class="oferta oferta-destaque r">
    <p class="oferta-nome">{{ ofertas.sessao.nome }}</p>
    <p class="oferta-preco"><span class="data-stat">{{ ofertas.sessao.valor | brl }}</span></p>
    <p class="oferta-entrega">{{ ofertas.sessao.entrega }}</p>
{%- if ofertas.sessao.itens %}
    <ul class="oferta-itens">
      {%- for item in ofertas.sessao.itens %}
      <li>{{ item }}</li>
      {%- endfor %}
    </ul>
{%- endif %}
    <a href="{{ ofertas.sessao.whatsappTexto | whatsapp(site.numeroWhatsapp) }}"
       target="_blank" rel="noopener"
       class="oferta-btn oferta-btn-forte"
       onclick="if(window.posthog)posthog.capture('oferta_click',{oferta:'sessao',origem:'{{ ofertaOrigem or page.fileSlug }}'})">
      {{ ofertas.sessao.cta }} · {{ ofertas.sessao.valor | brl }}
    </a>
    <a href="{{ ofertas.duvida.whatsappTexto | whatsapp(site.numeroWhatsapp) }}"
       target="_blank" rel="noopener" class="oferta-duvida">{{ ofertas.duvida.texto }}</a>
  </div>

</div>
