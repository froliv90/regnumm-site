{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/perfis",
      "destination": "/perfis.html",
      "permanent": true
    },
    {
      "source": "/perfis/",
      "destination": "/perfis.html",
      "permanent": true
    },
    {
      "source": "/blog/feed",
      "destination": "/blog/feed.xml",
      "permanent": false
    },
    {
      "source": "/teste/:path+/",
      "destination": "/mapa/:path+/",
      "permanent": true
    },
    {
      "source": "/teste/:path+",
      "destination": "/mapa/:path+/",
      "permanent": true
    },
    {
      "source": "/teste/",
      "destination": "/mapa/",
      "permanent": true
    },
    {
      "source": "/teste",
      "destination": "/mapa/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/mapa",
      "destination": "https://regnumm-diagnostico.vercel.app/mapa"
    },
    {
      "source": "/mapa/",
      "destination": "https://regnumm-diagnostico.vercel.app/mapa"
    },
    {
      "source": "/mapa/:path+/",
      "destination": "https://regnumm-diagnostico.vercel.app/mapa/:path+"
    },
    {
      "source": "/mapa/:path+",
      "destination": "https://regnumm-diagnostico.vercel.app/mapa/:path+"
    },
    {
      "source": "/teste-static/:path+",
      "destination": "https://regnumm-diagnostico.vercel.app/teste-static/:path+"
    },
    {
      "source": "/api/sessoes",
      "destination": "https://regnumm-diagnostico.vercel.app/api/sessoes"
    },
    {
      "source": "/api/sessoes/",
      "destination": "https://regnumm-diagnostico.vercel.app/api/sessoes"
    },
    {
      "source": "/api/leitura",
      "destination": "https://regnumm-diagnostico.vercel.app/api/leitura"
    },
    {
      "source": "/api/leitura/",
      "destination": "https://regnumm-diagnostico.vercel.app/api/leitura"
    },
    {
      "source": "/api/checkout",
      "destination": "https://regnumm-diagnostico.vercel.app/api/checkout"
    },
    {
      "source": "/api/checkout/",
      "destination": "https://regnumm-diagnostico.vercel.app/api/checkout"
    },
    {
      "source": "/api/termos",
      "destination": "https://regnumm-diagnostico.vercel.app/api/termos"
    },
    {
      "source": "/api/termos/",
      "destination": "https://regnumm-diagnostico.vercel.app/api/termos"
    }
  ],
  "headers": [
    {
      "source": "/assets/fonts/:arquivo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/css/:arquivo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/js/:arquivo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/icones/:arquivo",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/felipe.webp",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
